<?xml version="1.0" encoding="utf-8"?>
<!-- Mengizinkan koneksi HTTP ke IP/domain lokal (LAN & localhost) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
